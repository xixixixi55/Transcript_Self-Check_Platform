.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Output / generated assets — must never be tracked
output/
packages/output/
**/output/

# Archive external snapshot root (BIJI_ARCHIVE_EXTERNAL_ROOT) — local generated data
external-snapshots/

# Local verification tooling — never part of the repo
hashmyfiles/

# Persistent workbench database and controlled case assets — local only
**/workbench.sqlite3
**/workbench.sqlite3-*
**/instances/*/assets/

# Archives and packages — local only
*.rar
*.zip

# Word temporary lock files — must never be tracked
~$*.doc
~$*.docx
*.tmp
*.temp

# Logs
*.log
logs/
PORTABLE-FILES.json

# Test coverage
coverage/
.nyc_output/

# Harness
.claude/plan_mode.md


{
  "schema_version": 1,
  "product": "文枢",
  "version": "0.2.0",
  "platform": "windows-x64",
  "node_version": "22.23.2",
  "officecli_package": "@officecli/officecli",
  "officecli_version": "1.0.144",
  "hashmyfiles_version": "2.51",
  "python_runtime_dependencies": {
    "python": "3.11.0",
    "fastapi": "0.136.1",
    "uvicorn": "0.46.0",
    "pydantic": "2.13.3",
    "beautifulsoup4": "4.15.0",
    "lxml": "6.1.1",
    "python-docx": "1.2.0",
    "celery": "5.6.3",
    "redis": "8.0.1",
    "httpx": "0.28.1",
    "python-multipart": "0.0.32",
    "aiofiles": "25.1.0",
    "psutil": "7.2.2"
  },
  "required_paths": [
    "文枢.exe",
    "runtime/backend/backend.exe",
    "runtime/node/node.exe",
    "runtime/node/LICENSE",
    "tools/officecli/officecli.js",
    "tools/officecli/vendor/officecli.exe",
    "tools/hashmyfiles/HashMyFiles.exe",
    "tools/hashmyfiles/readme.txt",
    "resources/word_templates/template.docx",
    "web/index.html",
    "THIRD-PARTY-NOTICES.txt",
    "portable-manifest.json",
    "licenses/officecli-Apache-2.0.txt",
    "VERSION"
  ],
  "allowed_globs": [
    "文枢.exe",
    "runtime/backend/**",
    "runtime/node/node.exe",
    "runtime/node/LICENSE",
    "tools/officecli/officecli.js",
    "tools/officecli/package.json",
    "tools/officecli/README.md",
    "tools/officecli/lib/install-binary.js",
    "tools/officecli/vendor/officecli.exe",
    "tools/hashmyfiles/HashMyFiles.exe",
    "tools/hashmyfiles/HashMyFiles.cfg",
    "tools/hashmyfiles/HashMyFiles.chm",
    "tools/hashmyfiles/readme.txt",
    "resources/word_templates/template*.docx",
    "web/index.html",
    "web/assets/**",
    "licenses/officecli-Apache-2.0.txt",
    "THIRD-PARTY-NOTICES.txt",
    "portable-manifest.json",
    "VERSION",
    "使用说明.txt",
    "PORTABLE-FILES.json"
  ],
  "forbidden_globs": [
    "**/workbench.sqlite3*",
    "**/*.rar",
    "**/*.env",
    "**/.env*",
    "**/*.log",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/uploads/**",
    "**/output/**",
    "**/WinRAR.exe",
    "**/rar.exe"
  ]
}

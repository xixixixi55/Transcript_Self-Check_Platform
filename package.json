{
  "name": "biji-zijian-platform",
  "version": "0.1.0",
  "private": true,
  "description": "笔录自检平台（文枢）— 电子数据检查笔录自动生成平台",
  "scripts": {
    "dev": "concurrently \"pnpm --filter @biji/frontend dev\" \"pnpm --filter @biji/backend dev\"",
    "build": "pnpm --filter @biji/frontend build",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "verify:portable": "python scripts/verify-portable-package.py",
    "typecheck": "pnpm --filter @biji/shared build && pnpm --filter @biji/shared typecheck && pnpm --filter @biji/frontend typecheck",
    "lint:arch": "npx tsx scripts/lint-arch.ts",
    "test:frontend": "pnpm --filter @biji/frontend test",
    "test:backend": "pnpm --filter @biji/backend test",
    "test": "npm run test:frontend && npm run test:backend",
    "test:governance": "tsx scripts/check-docs-utils.test.ts",
    "verify:quick": "npm run lint:arch && npm run typecheck && npm run test:governance && npm run verify:docs && npm run check:repository-assets",
    "verify:frontend": "npm run typecheck && npm run test:frontend",
    "verify:frontend:build": "npm run build",
    "verify:backend": "npm run test:backend",
    "verify:docs": "npx tsx scripts/check-docs.ts",
    "verify:docs:strict": "npx tsx scripts/check-docs.ts --strict",
    "verify:docs:strict:all": "npx tsx scripts/check-docs.ts --strict --all",
    "verify:preflight": "tsx scripts/verify-preflight.ts",
    "verify:full": "tsx scripts/verify-full.ts",
    "verify:full:all": "tsx scripts/verify-full.ts --all",
    "verify": "npm run verify:full:all",
    "check:repository-assets": "npx tsx scripts/check-repository-assets.ts",
    "check-docs": "npm run verify:docs",
    "pre-commit": "npm run verify:quick",
    "prepare": "husky"
  },
  "dependencies": {
    "@pxp995/harness-ospx": "^1.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0"
}
